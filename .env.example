# ==========================================
# NEXUS HR — ENVIRONMENT CONFIGURATION TEMPLATE
# Distributed Two-Node PostgreSQL Setup
# ==========================================

# Application Environment
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta
PORT=3000

# ------------------------------------------
# NODE 1 — CENTRAL DATABASE (nexus-central)
# ------------------------------------------
# Supabase Project Ref: wcmevigbqsmzsdqidjel
# Host: db.wcmevigbqsmzsdqidjel.supabase.co
# Region: ap-southeast-1 (Singapore)
SUPABASE_CENTRAL_URL=https://wcmevigbqsmzsdqidjel.supabase.co
SUPABASE_CENTRAL_ANON_KEY=your_central_anon_key_here
# Server-side only (NEVER expose to frontend or public client)
SUPABASE_CENTRAL_SERVICE_ROLE_KEY=your_central_service_role_key_here
# Direct PostgreSQL connection strings (Server / Migration use only)
CENTRAL_DATABASE_URL=postgresql://postgres:[YOUR-CENTRAL-DB-PASSWORD]@db.wcmevigbqsmzsdqidjel.supabase.co:5432/postgres
CENTRAL_DIRECT_URL=postgresql://postgres:[YOUR-CENTRAL-DB-PASSWORD]@db.wcmevigbqsmzsdqidjel.supabase.co:5432/postgres

# ------------------------------------------
# NODE 2 — BRANCH A DATABASE (nexus-branch-a)
# ------------------------------------------
# Supabase Project Ref: uneycmbqqpkifwhwzbes
# Host: db.uneycmbqqpkifwhwzbes.supabase.co
# Region: ap-southeast-1 (Singapore)
SUPABASE_BRANCH_A_URL=https://uneycmbqqpkifwhwzbes.supabase.co
SUPABASE_BRANCH_A_ANON_KEY=your_branch_a_anon_key_here
# Server-side only (NEVER expose to frontend or public client)
SUPABASE_BRANCH_A_SERVICE_ROLE_KEY=your_branch_a_service_role_key_here
# Direct PostgreSQL connection strings (Server / Migration use only)
BRANCH_A_DATABASE_URL=postgresql://postgres:[YOUR-BRANCH-A-DB-PASSWORD]@db.uneycmbqqpkifwhwzbes.supabase.co:5432/postgres
BRANCH_A_DIRECT_URL=postgresql://postgres:[YOUR-BRANCH-A-DB-PASSWORD]@db.uneycmbqqpkifwhwzbes.supabase.co:5432/postgres

# ------------------------------------------
# BACKEND API GATEWAY SECURITY CONFIGURATION
# ------------------------------------------
# Central Auth verification settings
CENTRAL_JWKS_URL=https://wcmevigbqsmzsdqidjel.supabase.co/auth/v1/.well-known/jwks.json
CENTRAL_JWT_ISSUER=https://wcmevigbqsmzsdqidjel.supabase.co/auth/v1
CENTRAL_JWT_AUDIENCE=authenticated
JWKS_CACHE_TTL_SECONDS=300
JWT_CLOCK_SKEW_SECONDS=5

# Target Branch A canonical identifier (matches public.branch_config.id)
BRANCH_A_ID=00000000-0000-0000-0000-000000000001
BRANCH_A_CODE=BRANCH-A

# Optional CORS Allowed Origins (comma-separated allowlist; wildcard '*' is prohibited with credentials)
# CORS_ALLOWED_ORIGINS=https://app.nexus.local,https://admin.nexus.local

# Out-of-Band 256-bit HMAC Signing Key (NEVER commit real values; must match nexus_internal.gateway_signing_keys)
# IMPORTANT: Store the exact same UTF-8 string (e.g., 64-char hex output) on both Gateway and SQL nexus_internal.gateway_signing_keys.
# Generate locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GATEWAY_ACTOR_HMAC_KEY_ID=gw-hmac-v1
GATEWAY_ACTOR_HMAC_KEY=replace_with_64_char_hex_256bit_random_secret_do_not_commit
# Optional rotation ring JSON (for multi-key rotation, grace-window expiry & revocation management):
# GATEWAY_ACTOR_HMAC_KEYS_JSON=[{"keyId":"gw-hmac-v1","secret":"...","isActive":true,"activatedAt":"2026-11-11T00:00:00Z","expiresAt":null,"revokedAt":null}]
GATEWAY_ACTOR_TTL_SECONDS=60
GATEWAY_REQUEST_TIMEOUT_MS=5000
